# Copy to .env and fill in. Restart with `npm start -- --clear` after changing it.
#
# Option A (quick local dev): read directly by the app at bundle time.
EXPO_PUBLIC_PENNEY_AI_API_KEY=
# Optional: your own proxy that forwards POST /v1/messages and adds the key server-side.
# When set, AI mode works without any API key in the app. Use this for shared builds.
EXPO_PUBLIC_PENNEY_AI_BASE_URL=
# Optional: defaults to DEFAULT_AI_MODEL in src/config/aiConfig.ts
EXPO_PUBLIC_PENNEY_AI_MODEL=
# Optional: set to false to force the offline line bank
EXPO_PUBLIC_PENNEY_AI_ENABLED=

# Option B (app config / EAS builds): copied into extra.penneyAi by app.config.ts.
PENNEY_AI_API_KEY=
PENNEY_AI_BASE_URL=
PENNEY_AI_MODEL=
PENNEY_AI_ENABLED=

# Optional: set to false to hide the demo preset entry points.
EXPO_PUBLIC_PENNEY_DEMO_ENABLED=
